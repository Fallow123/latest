---
import { site } from '../site';
const topics = ['Ivanti', 'TeamDynamix', 'NetDocuments', 'Intercom', 'Project management', 'Behavioral science for leadership', 'Something else'];
---

<section id="contact" class="section contact">
  <div class="container contact-grid">
    <div class="reveal">
      <p class="eyebrow">Let's talk</p>
      <h2 class="title-line">Request Your Discovery or Demo Call Today!</h2>
      <p>
        Fill out the form and a member of our team will reach out within 24 hours. Need help right away?
        Email us at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
    <form
      class="card form reveal"
      name="discovery-call"
      method="POST"
      action={site.formAction || undefined}
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="discovery-call" />
      <!-- Spam trap: hidden from people, bots fill it in and Netlify drops the submission. -->
      <p class="visually-hidden" aria-hidden="true">
        <label>Leave this empty<input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <label>Name<input name="name" autocomplete="name" required /></label>
      <div class="form-row">
        <label>Work email<input type="email" name="email" autocomplete="email" required /></label>
        <label>Company<input name="company" autocomplete="organization" /></label>
      </div>
      <label>
        What can we help with?
        <select name="topic" required>
          <option value="" disabled selected>Choose one</option>
          {topics.map((t) => <option>{t}</option>)}
        </select>
      </label>
      <label>Message<textarea name="message" rows="4" placeholder="Tell us a little about your project"></textarea></label>
      <button type="submit" class="btn">Request a call</button>
    </form>
  </div>
</section>
