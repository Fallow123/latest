---
// Home page. The words live in src/content/home.md; this file only lays them out.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, speakers, stats } from '../site';

const home = (await getEntry('home', 'home'))!;
const d = home.data;
const humanHosts = [speakers.kip];
// Shown beside Ivanti in the hero so the newer partnerships get real visibility too.
const partners = [
  { name: 'TeamDynamix', label: 'Certified Partner', href: '/teamdynamix', logo: '/images/shared/teamdynamix-logo-reversed.png' },
  { name: 'NetDocuments', label: 'Trusted Partner', href: '/netdocuments', logo: '/images/netdocuments/netdocuments-logo-white.png' },
];
---

<Base title={d.title} description={d.description}>
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-text">
        <a class="eyebrow eyebrow-link" href="/behavioral-science-leadership">Now offering behavioral science for leadership <span aria-hidden="true">→</span></a>
        <h1>{d.heading}</h1>
        <p class="lead">{d.intro}</p>
        <div class="hero-actions">
          <a class="btn" href="#contact">Request a discovery call</a>
          <a class="btn btn-outline" href="/about">More about us</a>
        </div>
      </div>
      <div class="partner-panel" aria-label="Our technology partners">
        <p class="partner-panel-label">Our technology partners</p>
        <a class="partner-lead" href="/ivanti">
          <img src={site.ivantiBadge} alt="Ivanti Premier Partner badge" width="411" height="139" />
          <span>Long-time Ivanti Premier Partner with 100+ years of combined Ivanti experience</span>
        </a>
        <div class="partner-row">
          {partners.map((p) => (
            <a class="partner-tile" href={p.href}>
              <img src={p.logo} alt={p.name} loading="eager" />
              <span>{p.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="Latest Solutions at a glance">
    <div class="container stats-grid stagger">
      {
        stats.map((s) => {
          const m = s.value.match(/^(\d+)(\D*)$/);
          return (
            <div class="stat reveal">
              <span class="stat-value" data-count={m && s.value !== '2011' ? m[1] : undefined} data-suffix={m ? m[2] : undefined}>
                {s.value}
              </span>
              <span class="stat-label">{s.label}</span>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <p class="eyebrow">Our solutions</p>
        <h2 class="title-line">Platforms we implement and support</h2>
        <p>{d.platformsIntro}</p>
      </div>
      <div class="grid solutions stagger">
        {
          d.solutions.map((s) => (
            <a class="card card-link solution reveal" href={s.href}>
              <span class="solution-logo">{s.icon && <img src={s.icon} alt={s.title} loading="lazy" />}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="more">Learn more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    d.humanSide && (
      <section class="section dark human">
        <div class="container human-grid">
          <div class="reveal">
            <p class="eyebrow">What sets us apart · Behavioral science</p>
            <h2 class="title-line">{d.humanSide.title}</h2>
            <p>{d.humanSide.text}</p>
            <div class="host-row">
              {humanHosts.map((h) =>
                h.photo ? <img class="avatar" src={h.photo} alt="" /> : <span class="avatar" aria-hidden="true">{h.name.split(' ').map((w) => w[0]).join('')}</span>
              )}
              <span>{humanHosts.map((h) => h.name).join(' & ')}</span>
            </div>
            <div class="hero-actions">
              <a class="btn" href="/behavioral-science-leadership">Explore behavioral science for leadership</a>
            </div>
          </div>
          <div class="human-cards stagger">
            {d.humanSide.cards.map((c) => (
              <a class="card card-link reveal" href={c.href}>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
                <span class="more">Learn more →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section dark">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why work with us</p>
        <h2 class="title-line">Benefits of Consulting and Implementation Services</h2>
      </div>
      <div class="grid stagger">
        {
          d.benefits.map((b, i) => (
            <div class="card reveal">
              <span class="num">0{i + 1}</span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
      <div class="expertise reveal">
        <h3>Certified across the Ivanti portfolio</h3>
        <ul class="pill-list">{d.expertise.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>
