---
// Renders every Markdown file in src/content/pages as its own page.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SpeakerCards from '../components/SpeakerCards.astro';
import PatchCatalog from '../components/PatchCatalog.astro';
import { implementationServices } from '../site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const d = page.data;
const { Content } = await render(page);

// Overview paragraphs: plain text with **bold** and [links](url) only, escaped before formatting.
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const overview = d.overview?.split(/\n\s*\n/).map((p) =>
  esc(p.trim())
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, t, u) => `<a href="${u}"${/^https?:/.test(u) ? ' target="_blank" rel="noopener"' : ''}>${t}</a>`)
);

// Lets Google show the questions and answers directly in search results.
const faqSchema = d.faqs && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={d.title} description={d.description} contactForm={d.contactForm}>
  <section class="hero">
    <div class={d.heroImage ? 'container hero-split' : 'container'}>
      <div class="hero-text">
        {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
        <h1>{d.heading}</h1>
        {d.intro && <p class="lead">{d.intro}</p>}
        <div class="hero-actions">
          <a class="btn" href={d.cta?.href ?? '#contact'}>{d.cta?.label ?? 'Free consultation'}</a>
        </div>
      </div>
      {d.heroImage && (
        <picture>
          {d.heroImage.still && <source media="(prefers-reduced-motion: reduce)" srcset={d.heroImage.still} />}
          <img class:list={['hero-image', { 'hero-shot': d.heroImage.screenshot }]} src={d.heroImage.src} alt={d.heroImage.alt} />
        </picture>
      )}
    </div>
  </section>

  {
    d.certifications && (
      <section class="section cert-section" id="certifications">
        <div class="container">
          <div class="cert-band reveal">
            <div class="cert-cycle" style={`--n:${d.certifications.badges.length}`} role="img" aria-label={`${d.certifications.badges.length} certification badges`}>
              {d.certifications.badges.map((b, i) => <img src={b.src} alt={b.alt} width="440" height="440" style={`--i:${i}`} />)}
            </div>
            <div class="cert-copy">
              <p class="eyebrow">{d.certifications.title}</p>
              <p class="cert-count"><strong>{d.certifications.badges.length}</strong> certifications</p>
              <p>{d.certifications.text}</p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {d.patchCatalog && <PatchCatalog />}

  {
    d.spotlight && (
      <section class="section spotlight" id="patch-catalog">
        <div class="container">
          <div class="spotlight-grid">
            <div class="reveal">
              {d.spotlight.eyebrow && <p class="eyebrow">{d.spotlight.eyebrow}</p>}
              <h2 class="title-line">{d.spotlight.title}</h2>
              {d.spotlight.text.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
              {d.spotlight.source && (
                <p class="spotlight-source">
                  Source: <a href={d.spotlight.source.href} target="_blank" rel="noopener">{d.spotlight.source.label}</a>
                </p>
              )}
            </div>
            <div class="reveal">
              {d.spotlight.stats && (
                <div class="spotlight-stats">
                  {d.spotlight.stats.map((st) => (
                    <div class="card">
                      <strong>{st.value}</strong>
                      <span>{st.label}</span>
                    </div>
                  ))}
                </div>
              )}
              {d.spotlight.tags && (
                <div class="spotlight-tags">
                  {d.spotlight.tagsTitle && <p>{d.spotlight.tagsTitle}</p>}
                  <ul class="pill-list">{d.spotlight.tags.map((t) => <li>{t}</li>)}</ul>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    overview && (
      <section class="section" id={d.overviewId}>
        <div class="container prose reveal">
          {d.overviewTitle && <h2>{d.overviewTitle}</h2>}
          {overview.map((p) => <p set:html={p} />)}
        </div>
      </section>
    )
  }

  {
    d.cards && (
      <section class={d.cardsDark ? 'section dark' : 'section soft'}>
        <div class="container">
          {d.cardsTitle && <h2 class="center title-line reveal">{d.cardsTitle}</h2>}
          <div class:list={["grid stagger", { "grid-3": d.cards.length % 3 === 0 || d.cards.length === 5 }]}>
            {d.cards.map((c) =>
              c.href ? (
                <a class="card card-link reveal" href={c.href}>
                  {c.icon && <img class="icon" src={c.icon} alt="" />}
                  <h3>{c.title}</h3>
                  {c.text && <p>{c.text}</p>}
                </a>
              ) : (
                <div class="card reveal">
                  {c.icon && <img class="icon" src={c.icon} alt="" />}
                  <h3>{c.title}</h3>
                  {c.text && <p>{c.text}</p>}
                </div>
              )
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    d.cardGroups && (
      <section class="section soft">
        <div class="container card-groups">
          {d.cardGroups.map((g) => (
            <div class="card-group" id={g.id}>
              <div class="section-head reveal">
                <h2 class="title-line">{g.title}</h2>
                {g.intro && <p>{g.intro}</p>}
              </div>
              <div class:list={['grid stagger', { 'grid-3': g.cards.length % 3 === 0 }]}>
                {g.cards.map((c) => (
                  <a class="card card-link reveal" href={c.href}>
                    {c.icon && <img class="icon" src={c.icon} alt="" />}
                    <h3>{c.title}</h3>
                    {c.text && <p>{c.text}</p>}
                    <span class="more">Explore →</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    d.showcase && (
      <section class="section">
        <div class="container">
          {d.showcaseTitle && <h2 class="center title-line reveal">{d.showcaseTitle}</h2>}
          <div class="showcase">
            {d.showcase.map((row) => (
              <div class="showcase-row reveal">
                <img src={row.image} alt={row.alt} loading="lazy" />
                <div>
                  <h3>{row.title}</h3>
                  <p>{row.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.recognition && (
      <section class="section">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">Analyst recognition</p>
            <h2 class="title-line">{d.recognitionTitle ?? 'Analyst recognition'}</h2>
            {d.recognitionIntro && <p>{d.recognitionIntro}</p>}
          </div>
          <div class="grid recognition stagger">
            {d.recognition.map((r) => (
              <div class="card reveal">
                <p class="recognition-label">{r.label}</p>
                <h3>{r.report}</h3>
                <a class="recognition-source" href={r.source} target="_blank" rel="noopener">
                  Source: {new URL(r.source).hostname.replace(/^www\./, '')}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.logos && (
      <section class="section">
        <div class="container">
          <h2 class="center title-line reveal">Our Partners</h2>
          <div class="logo-wall stagger">
            {d.logos.map((l) => (
              <a class="reveal" href={l.href} target="_blank" rel="noopener">
                {l.image ? <img src={l.image} alt={l.name} /> : <span>{l.name}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class:list={['container prose reveal', { checklist: d.checklist ?? d.services }]}>
      <Content />
    </div>
  </section>

  {
    d.services && (
      <section class={d.faqs ? 'section soft' : 'section cta-band'}>
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">How we help</p>
            <h2 class="title-line">Services for implementation</h2>
            {d.servicesIntro?.split(/\n\s*\n/).map((p) => <p>{p}</p>)}
          </div>
          <div class="grid grid-3 stagger">
            {implementationServices.map((s) => (
              <div class="card reveal">
                <img class="icon" src={s.icon} alt="" />
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.speakers && (
      <section class="section soft">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">The team</p>
            <h2 class="title-line">{d.speakersTitle ?? 'Who you will work with'}</h2>
          </div>
          <SpeakerCards keys={d.speakers} />
        </div>
      </section>
    )
  }

  {
    d.faqs && (
      <section class="section">
        <div class="container faq">
          <div class="reveal">
            <p class="eyebrow">FAQ</p>
            <h2 class="title-line">Common questions</h2>
          </div>
          <div class="faq-list reveal">
            {d.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      </section>
    )
  }
</Base>
