---
import '../styles/global.css';
import Announcement from '../components/Announcement.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  contactForm?: boolean;
}
const { title, description, contactForm = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews use the host the page is actually served from (Netlify sets URL / DEPLOY_PRIME_URL),
// so they work on the Netlify site and deploy previews before the domain switch.
// Using the www domain here would make Facebook/LinkedIn fetch the old Wix page instead.
const env = process.env;
const host = (env.CONTEXT === 'production' ? env.URL : env.DEPLOY_PRIME_URL) ?? env.URL ?? Astro.site;
const pageUrl = new URL(Astro.url.pathname, host).href;
const ogImage = new URL('/og-image.png?v=2', host).href; // source: scripts/og/og-image.html
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Latest Solutions" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Latest Solutions: IT consultancy from experienced solution architects. Ivanti Premier Partner, NetDocuments and TeamDynamix Certified Partner." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Marks that JavaScript runs, so scroll animations only hide content when they can show it again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Announcement />
    <Header />
    <main>
      <slot />
      {contactForm && <ContactForm />}
    </main>
    <Footer />
    <ChatWidget />
    <script>
      // Fade sections in as they scroll into view (once each), and count the stats up from 0.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const suffix = el.dataset.suffix ?? '';
        if (reduceMotion || !target) return;
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / 1200, 1);
          el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))) + suffix;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.classList.add('in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            observer.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Cards get a soft spotlight that follows the pointer (see .card::after).
      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>
